# Environment: dev, test, or prod
ENV=dev

# Flask secret key (generate a secure random key for production)
SECRET_KEY=dev-secret-key-change-in-production

# Port to run the application on
PORT=5000

# CalNet OIDC Configuration (web app only)
CLIENT_ID=your-oidc-client-id
CLIENT_SECRET=your-oidc-client-secret
BASE_URL=https://your-host/your-path
CALNET_ENVIRONMENT=test

# Below: credentials for the external systems the flow queries. These are
# needed by both the CLI and the web app (they're read by the ucbhr, sis,
# grouper, and calnet-resolve packages themselves, not by this project's
# own code) - see each package's own README for exactly how it reads them.

# Grouper (CalGroups) credentials
GROUPER_USER=your-grouper-username
GROUPER_PASS=your-grouper-password
GROUPER_BASE_URI=https://calgroups.berkeley.edu/gws/servicesRest/json/v2_2_100

# UC Berkeley HR system (ucbhr) API credentials
UCBHR_EMPLOYEES_ID=your-employees-api-id
UCBHR_EMPLOYEES_KEY=your-employees-api-key
UCBHR_DEPARTMENTS_ID=your-departments-api-id
UCBHR_DEPARTMENTS_KEY=your-departments-api-key

# Student Information System (sis) API credentials
SIS_CLASSES_ID=your-classes-api-id
SIS_CLASSES_KEY=your-classes-api-key
SIS_COURSE_ID=your-course-api-id
SIS_COURSE_KEY=your-course-api-key
SIS_ENROLLMENTS_ID=your-enrollments-api-id
SIS_ENROLLMENTS_KEY=your-enrollments-api-key
SIS_STUDENTS_ID=your-students-api-id
SIS_STUDENTS_KEY=your-students-api-key
SIS_TERMS_ID=your-terms-api-id
SIS_TERMS_KEY=your-terms-api-key

# calnet-resolve: only needed for shortname-based lookups (flow-shortname.yaml),
# to resolve a shortname to a CalNet UID via a privileged LDAP bind. No default -
# both must be set for that flow to work.
CALNET_RESOLVE_BIND_DN=uid=your-service-account,ou=applications,dc=berkeley,dc=edu
CALNET_RESOLVE_BIND_PASSWORD=your-bind-password

# Department LDAP, used to detect whether someone already has an account.
# Kept here rather than in the flow files so the server isn't published.
DEPT_LDAP_URI=ldaps://ldap.your-dept.berkeley.edu
DEPT_LDAP_BASE_DN=cn=users,dc=your-dept,dc=berkeley,dc=edu
